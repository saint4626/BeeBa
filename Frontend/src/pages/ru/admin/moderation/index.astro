---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import ModerationApp from "../../../../components/admin/ModerationApp.vue";
import { getServerAPIBaseURL } from "../../../../lib/api/client";
import { ui } from "../../../../lib/i18n";

const locale = "ru";
const t = ui[locale];
const loginHref = `/ru/login?next=${encodeURIComponent("/ru/admin/moderation")}`;
let hasAdminAccess = false;

try {
  const statusResponse = await fetch(`${getServerAPIBaseURL()}/admin/status`, {
    headers: {
      Accept: "application/json",
      Cookie: Astro.request.headers.get("cookie") ?? "",
    },
  });

  hasAdminAccess = statusResponse.ok;
  if (statusResponse.status === 401) {
    return Astro.redirect(loginHref, 302);
  }
} catch {
  hasAdminAccess = false;
}

if (!hasAdminAccess) {
  return Astro.redirect(t.admin.fallbackPath, 302);
}
---

<BaseLayout
  title={t.admin.title}
  description={t.admin.description}
  canonicalPath="/ru/admin/moderation"
>
  <div class="page-container">
    <section class="catalog-head" aria-labelledby="moderation-title">
      <div class="catalog-head__copy">
        <p class="eyebrow">{t.admin.eyebrow}</p>
        <h1 id="moderation-title">{t.admin.heading}</h1>
        <p class="lead">{t.admin.lead}</p>
      </div>
    </section>

    <ModerationApp client:load locale={locale} />
  </div>
</BaseLayout>
