---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AccountActionConfirmationApp from "../../components/auth/AccountActionConfirmationApp.vue";
import { ui } from "../../lib/i18n";

const locale = "ru";
const t = ui[locale];
---

<BaseLayout
  title={t.accountConfirm.emailTitle}
  description={t.accountConfirm.emailDescription}
  canonicalPath="/ru/confirm-email-change"
  robots="noindex, nofollow"
>
  <section class="page-shell page-shell--narrow">
    <AccountActionConfirmationApp client:load kind="email" locale={locale} profileHref="/ru/profile" loginHref="/ru/login" />
  </section>
</BaseLayout>
