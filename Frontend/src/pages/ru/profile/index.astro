---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProfileApp from "../../../components/profile/ProfileApp.vue";
import { getServerAPIBaseURL } from "../../../lib/api/client";
import { ui } from "../../../lib/i18n";
import type { PublicUser } from "../../../lib/api/types";

const locale = "ru";
const t = ui[locale];
const loginHref = `/ru/login?next=${encodeURIComponent("/ru/profile")}`;
let user: PublicUser | null = null;
try {
  const meResponse = await fetch(`${getServerAPIBaseURL()}/auth/me`, {
    headers: {
      Accept: "application/json",
      Cookie: Astro.request.headers.get("cookie") ?? "",
    },
  });

  if (meResponse.ok) {
    const mePayload = (await meResponse.json()) as { data: PublicUser };
    user = mePayload.data;
  }
} catch {
  user = null;
}

if (!user) {
  return Astro.redirect(loginHref, 302);
}
---

<BaseLayout
  title={t.profile.title}
  description={t.profile.description}
  canonicalPath="/ru/profile"
  robots="noindex, nofollow"
>
  <div class="profile-workspace">
    <section class="profile-workspace__head" aria-labelledby="profile-title">
      <div>
        <p class="eyebrow">{t.profile.eyebrow}</p>
        <h1 id="profile-title">{t.profile.heading}</h1>
        <p>{t.profile.lead}</p>
      </div>
    </section>

    <ProfileApp client:load loginHref={loginHref} initialUser={user} locale={locale} />
  </div>
</BaseLayout>
