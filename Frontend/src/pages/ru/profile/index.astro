---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProfileApp from "../../../components/profile/ProfileApp.vue";
import { getServerAPIBaseURL } from "../../../lib/api/client";
import type { PublicUser } from "../../../lib/api/types";

const loginHref = `/ru/login?next=${encodeURIComponent("/ru/profile")}`;
let user: PublicUser | null = null;
try {
  const meResponse = await fetch(`${getServerAPIBaseURL()}/auth/me`, {
    headers: {
      Accept: "application/json",
      Cookie: Astro.request.headers.get("cookie") ?? "",
    },
  });

  if (meResponse.ok) {
    const mePayload = (await meResponse.json()) as { data: PublicUser };
    user = mePayload.data;
  }
} catch {
  user = null;
}

if (!user) {
  return Astro.redirect(loginHref, 302);
}
---

<BaseLayout
  title="Профиль - BeeBa"
  description="Управление аккаунтом BeeBa, аватаром, приватными и публичными загрузками, превью, галереями и метаданными контента."
  canonicalPath="/ru/profile"
>
  <div class="profile-workspace">
    <section class="profile-workspace__head" aria-labelledby="profile-title">
      <div>
        <p class="eyebrow">Private workspace</p>
        <h1 id="profile-title">Профиль</h1>
        <p>
          Управляйте аккаунтом, аватаром, загрузками, видимостью, причинами модерации,
          превью и галереями контента из одного приватного пространства.
        </p>
      </div>
    </section>

    <ProfileApp client:load loginHref={loginHref} initialUser={user} />
  </div>
</BaseLayout>
