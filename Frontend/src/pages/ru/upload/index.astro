---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import UploadApp from "../../../components/upload/UploadApp.vue";
import { getServerAPIBaseURL } from "../../../lib/api/client";
import { ui } from "../../../lib/i18n";
import type { PublicUser } from "../../../lib/api/types";

const locale = "ru";
const t = ui[locale];
const loginHref = `/ru/login?next=${encodeURIComponent("/ru/upload")}`;
let user: PublicUser | null = null;

try {
  const meResponse = await fetch(`${getServerAPIBaseURL()}/auth/me`, {
    headers: {
      Accept: "application/json",
      Cookie: Astro.request.headers.get("cookie") ?? "",
    },
  });

  if (meResponse.ok) {
    const mePayload = (await meResponse.json()) as { data: PublicUser };
    user = mePayload.data;
  }
} catch {
  user = null;
}

if (!user) {
  return Astro.redirect(loginHref, 302);
}
---

<BaseLayout
  title={t.upload.title}
  description={t.upload.description}
  canonicalPath="/ru/upload"
  robots="noindex, nofollow"
>
  <div class="page-container">
    <section class="upload-head" aria-labelledby="upload-title">
      <div>
        <p class="eyebrow">{t.upload.eyebrow}</p>
        <h1 id="upload-title">{t.upload.heading}</h1>
        <p class="lead">{t.upload.lead}</p>
      </div>
    </section>

    <UploadApp client:load initialUser={user} loginHref={loginHref} locale={locale} />
  </div>
</BaseLayout>
