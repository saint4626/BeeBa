---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AccountActionConfirmationApp from "../../components/auth/AccountActionConfirmationApp.vue";
import { ui } from "../../lib/i18n";

const locale = "ru";
const t = ui[locale];
---

<BaseLayout
  title={t.accountConfirm.passwordTitle}
  description={t.accountConfirm.passwordDescription}
  canonicalPath="/ru/confirm-password-change"
>
  <section class="page-shell page-shell--narrow">
    <AccountActionConfirmationApp client:load kind="password" locale={locale} profileHref="/ru/profile" loginHref="/ru/login" />
  </section>
</BaseLayout>
