---
import CatalogView from "../../../components/catalog/CatalogView.astro";
import CatalogHeaderActions from "../../../components/catalog/CatalogHeaderActions.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { listCategories, listPublicContent, listTags } from "../../../lib/api/content";
import { PAGE_LIMITS } from "../../../lib/config/runtime";
import { ui } from "../../../lib/i18n";
import { buildLocaleAlternates } from "../../../lib/seo/content-url";
import { breadcrumbJsonLd } from "../../../lib/seo/structured-data";
import type { Category, CursorPagination, PublicContentItem } from "../../../lib/api/types";

const locale = "ru";
const t = ui[locale];
const site = Astro.site ?? new URL("http://localhost:4321");
const categoryLabels: Record<Category["slug"], string> = {
  worlds: t.categories.worlds,
  avatars: t.categories.avatars,
  props: t.categories.props,
  prefabs: t.categories.prefabs,
};

const { category } = Astro.params;
const activeCategory = category as Category["slug"];
const label = categoryLabels[activeCategory];
const canonicalPath = label ? `/ru/catalog/${activeCategory}` : `/ru/catalog/${category}`;
const alternatePaths = label ? buildLocaleAlternates(`/catalog/${activeCategory}`, canonicalPath) : [];
const jsonLd = label ? [
  breadcrumbJsonLd(site, [
    { name: t.nav.home, path: "/ru" },
    { name: t.nav.catalog, path: "/ru/catalog" },
    { name: label, path: canonicalPath },
  ]),
] : [];
if (!label) {
  Astro.response.status = 404;
}
const searchParams = Astro.url.searchParams;
const query = searchParams.get("q")?.trim() ?? "";
const activeTags = parseTags(searchParams.get("tags"));
const sort = normalizeSort(searchParams.get("sort"));
const includeNSFW = searchParams.get("include_nsfw") === "true";
const cursor = searchParams.get("cursor")?.trim() ?? "";

let categories = [
  { slug: "worlds", name: "Worlds" },
  { slug: "avatars", name: "Avatars" },
  { slug: "props", name: "Props" },
  { slug: "prefabs", name: "Prefabs" },
];
let tags = [];
let items: PublicContentItem[] = [];
let pagination: CursorPagination | undefined;
let error: string | undefined;

try {
  if (label) {
    const [categoryData, tagData, contentData] = await Promise.all([
      listCategories(),
      listTags(),
      listPublicContent({
        category: activeCategory,
        q: query,
        tags: activeTags,
        sort: sort === "likes" || sort === "downloads" ? sort : "newest",
        include_nsfw: includeNSFW,
        cursor,
        limit: PAGE_LIMITS.catalog,
      }),
    ]);
    categories = categoryData;
    tags = tagData;
    items = contentData.data;
    pagination = contentData.pagination;
  }
} catch (caught) {
  error = caught instanceof Error ? caught.message : t.catalog.unavailableTitle;
}

function parseTags(raw: string | null): string[] {
  if (!raw) return [];
  return Array.from(new Set(raw.split(",").map((tag) => tag.trim().toLowerCase()).filter(Boolean)));
}

function normalizeSort(raw: string | null): "newest" | "likes" | "downloads" {
  return raw === "likes" || raw === "downloads" ? raw : "newest";
}
---

<BaseLayout
  title={`${label ?? "Не найдено"} - ${t.catalog.categoryTitleSuffix}`}
  description={label ? `${t.catalog.categoryDescriptionPrefix} ${label.toLowerCase()} ${t.catalog.categoryDescriptionSuffix}` : t.catalog.categoryNotFoundTitle}
  canonicalPath={canonicalPath}
  alternatePaths={alternatePaths}
  robots={label ? undefined : "noindex, nofollow"}
  jsonLd={jsonLd}
>
  {label && (
    <CatalogHeaderActions
      slot="header-actions"
      tags={tags}
      query={query}
      activeTags={activeTags}
      sort={sort}
      includeNSFW={includeNSFW}
      activeCategory={activeCategory}
      baseCatalogPath="/ru/catalog"
      locale={locale}
    />
  )}
  {label ? (
    <CatalogView
      items={items}
      pagination={pagination}
      categories={categories}
      tags={tags}
      query={query}
      activeTags={activeTags}
      sort={sort}
      includeNSFW={includeNSFW}
      activeCategory={activeCategory}
      error={error}
      baseCatalogPath="/ru/catalog"
      locale={locale}
    />
  ) : (
    <div class="page-container">
      <div class="empty-state">
        <span class="empty-state__badge">404</span>
        <div>
          <h1>{t.catalog.categoryNotFoundTitle}</h1>
          <p>{t.catalog.categoryNotFoundCopy}</p>
        </div>
      </div>
    </div>
  )}
</BaseLayout>
