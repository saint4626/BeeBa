---
import {
  ChevronLeft,
  ChevronRight,
  Copy,
  Download,
  Heart,
  KeyRound,
  Link,
  MessageCircle,
  Package,
  ShieldCheck,
} from "lucide";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SocialPanel from "../../../components/content/SocialPanel.vue";
import LucideIcon from "../../../components/ui/LucideIcon.astro";
import { getPublicAPIBaseURL, publicAPIURL } from "../../../lib/api/client";
import { getPublicContent } from "../../../lib/api/content";
import { publicMediaURL } from "../../../lib/api/media-url";
import { BYTE_UNITS, HASH_DISPLAY } from "../../../lib/config/runtime";
import { localizedPath, ui } from "../../../lib/i18n";
import {
  buildContentCanonicalPaths,
  buildLocaleAlternates,
  contentMetaDescription,
  extractContentIDFromPathParam,
} from "../../../lib/seo/content-url";
import { breadcrumbJsonLd, contentJsonLd } from "../../../lib/seo/structured-data";
import type { PublicContentDetail, PublicContentImage } from "../../../lib/api/types";

export const prerender = false;

const { id } = Astro.params;
const locale = "ru";
const t = ui[locale];
const publicAPIBaseURL = getPublicAPIBaseURL();
const site = Astro.site ?? new URL("http://localhost:4321");
const contentID = extractContentIDFromPathParam(id);

let item: PublicContentDetail | null = null;
let error = "";

if (!contentID) {
  return Astro.redirect(localizedPath(locale, "/catalog"), 302);
}

try {
  const cookie = Astro.request.headers.get("cookie");
  item = await getPublicContent(contentID, cookie ? { headers: { Cookie: cookie } } : undefined);
} catch (caught) {
  if (caught instanceof Error && caught.message.toLowerCase().includes("not found")) {
    return Astro.redirect(localizedPath(locale, "/404"), 302);
  }
  error = caught instanceof Error ? caught.message : t.content.failedToLoad;
}

const pageTitle = item ? `${item.title} - BeeBa` : `${t.content.unavailableTitle} - BeeBa`;
const description = item ? contentMetaDescription(item, locale) : t.content.unavailableDescription;
const canonicalPaths = item ? buildContentCanonicalPaths(item) : null;
const canonicalPath = canonicalPaths?.ru ?? localizedPath(locale, "/catalog");
if (item && Astro.url.pathname !== canonicalPath) {
  return Astro.redirect(canonicalPath, 301);
}
const downloadAPIPath = item ? `/content/${item.id}/download` : "";
const downloadURL = downloadAPIPath ? `${publicAPIBaseURL}${downloadAPIPath}` : "";
const absoluteDownloadURL = downloadAPIPath ? publicAPIURL(downloadAPIPath) : "";
const loginHref = `${localizedPath(locale, "/login")}?next=${encodeURIComponent(Astro.url.pathname)}`;
const gallery = item ? uniqueImages(item) : [];
const primaryImage = gallery[0];
const primaryImageURL = primaryImage ? mediaURL(primaryImage) : "";
const socialImage = primaryImage && primaryImageURL ? {
  url: primaryImageURL,
  type: "image/webp",
  width: primaryImage.width,
  height: primaryImage.height,
  alt: primaryImage.alt_text || item?.title || "BeeBa Basis VR content asset",
} : undefined;
const publishedLabel = item?.published_at ? formatDate(item.published_at) : t.content.notPublished;
const categoryInitials = item ? categoryName().slice(0, 2).toUpperCase() : "BB";
const alternatePaths = canonicalPaths ? buildLocaleAlternates(canonicalPaths.en, canonicalPaths.ru) : [];
const jsonLd = item ? [
  breadcrumbJsonLd(site, [
    { name: t.nav.home, path: "/ru" },
    { name: t.nav.catalog, path: "/ru/catalog" },
    { name: categoryName(), path: `/ru/catalog/${item.category.slug}` },
    { name: item.title, path: canonicalPath },
  ]),
  contentJsonLd(site, item, locale, canonicalPath, primaryImageURL),
] : [];

function uniqueImages(content: PublicContentDetail): PublicContentImage[] {
  const seen = new Set<string>();
  return content.gallery.filter((image) => {
    if (seen.has(image.id)) return false;
    seen.add(image.id);
    return true;
  });
}

function mediaURL(image: PublicContentImage) {
  return publicMediaURL(publicAPIBaseURL, image.id);
}

function formatBytes(value?: number) {
  if (!value) return t.content.unknownSize;
  const units = ["B", "KB", "MB", "GB"];
  let size = value;
  let unit = 0;
  while (size >= BYTE_UNITS.kib && unit < units.length - 1) {
    size /= BYTE_UNITS.kib;
    unit += 1;
  }
  return `${unit === 0 ? size.toFixed(0) : size.toFixed(1)} ${units[unit]}`;
}

function shortHash(value?: string) {
  if (!value) return t.content.unavailableHash;
  return `${value.slice(0, HASH_DISPLAY.prefixLength)}...${value.slice(-HASH_DISPLAY.suffixLength)}`;
}

function formatDate(value: string) {
  return new Intl.DateTimeFormat(locale, { month: "short", day: "numeric", year: "numeric" }).format(new Date(value));
}

function categoryName() {
  return item ? ui[locale].categories[item.category.slug] : "";
}
---

<BaseLayout
  title={pageTitle}
  description={description}
  canonicalPath={canonicalPath}
  mainClass="main--flush-end"
  alternatePaths={alternatePaths}
  ogType="article"
  socialImage={socialImage}
  jsonLd={jsonLd}
>
  <div class="detail-shell">
    {error ? (
      <div class="catalog-empty" role="status">
        <div class="catalog-empty__title">
          <span aria-hidden="true"></span>
          <strong>{t.content.unavailableTitle}</strong>
          <span aria-hidden="true"></span>
        </div>
        <p>{error}</p>
      </div>
    ) : item && (
      <>
        <header class="detail-header" aria-labelledby="content-title">
          <div class="detail-kicker">
            <a href={localizedPath(locale, `/catalog/${item.category.slug}`)}>{categoryName()}</a>
            {item.nsfw && <span>{ui[locale].common.nsfw}</span>}
          </div>
          <div class="detail-header__body">
            <div>
              <h1 id="content-title">{item.title}</h1>
            </div>
            <div class="detail-header__stats" aria-label={t.content.statsLabel}>
              <span><LucideIcon node={Download} size={14} /> {item.downloads_count.toLocaleString()}</span>
              <span><LucideIcon node={Heart} size={14} /> {item.likes_count.toLocaleString()}</span>
              <span><LucideIcon node={MessageCircle} size={14} /> {item.comments_count.toLocaleString()}</span>
            </div>
          </div>
        </header>

        <section class="detail-layout" aria-labelledby="content-title">
          <div class="detail-main">
            <div class="detail-gallery" aria-label={`${item.title} ${t.content.galleryLabelSuffix}`}>
              {primaryImage ? (
                <div class="detail-gallery__carousel" data-content-carousel>
                  <div class="detail-gallery__viewport">
                    <div class="detail-gallery__track" data-carousel-track tabindex="0">
                      {gallery.map((image, index) => (
                        <figure class="detail-gallery__slide" data-carousel-slide>
                          <img src={mediaURL(image)} alt={image.alt_text || item.title} loading={index === 0 ? "eager" : "lazy"} />
                        </figure>
                      ))}
                    </div>
                    {gallery.length > 1 && (
                      <>
                        <button class="detail-gallery__arrow detail-gallery__arrow--prev" type="button" data-carousel-prev aria-label={t.content.previousImage}>
                          <LucideIcon node={ChevronLeft} size={20} />
                        </button>
                        <button class="detail-gallery__arrow detail-gallery__arrow--next" type="button" data-carousel-next aria-label={t.content.nextImage}>
                          <LucideIcon node={ChevronRight} size={20} />
                        </button>
                      </>
                    )}
                  </div>
                  {gallery.length > 1 && (
                    <div class="detail-gallery__thumbs" aria-label={t.content.thumbnails}>
                      {gallery.map((image, index) => (
                        <button type="button" data-carousel-thumb data-slide-index={String(index)} aria-label={`${t.content.showImagePrefix} ${index + 1}`} aria-current={index === 0 ? "true" : "false"}>
                          <img src={mediaURL(image)} alt="" loading="lazy" />
                        </button>
                      ))}
                    </div>
                  )}
                </div>
              ) : (
                <div class="detail-gallery__primary detail-gallery__primary--placeholder" aria-label={t.content.noPreview}>
                  <span>{categoryInitials}</span>
                </div>
              )}
            </div>

            <article class="detail-description">
              <p>{item.description || t.content.noDescription}</p>
              {item.tags.length > 0 && (
                <div class="detail-tags" aria-label={t.content.tagsLabel}>
                  {item.tags.map((tag) => <a href={localizedPath(locale, `/catalog?tags=${encodeURIComponent(tag.slug)}`)}>{tag.name}</a>)}
                </div>
              )}
            </article>
          </div>

          <aside class="detail-sidebar" aria-label={t.content.sidebarLabel}>
            <div class="detail-panel detail-panel--actions">
              <a class="button button--primary detail-download" href={downloadURL}>
                <LucideIcon node={Download} size={16} />
                <span>{t.content.download}</span>
              </a>
              <button class="detail-icon-button" type="button" data-copy-text={absoluteDownloadURL} data-copy-label={t.content.downloadCopied} aria-label={t.content.copyDownload} title={t.content.copyDownload}>
                <LucideIcon node={Link} size={16} />
              </button>
              {item.unlock_password && (
                <button class="detail-icon-button" type="button" data-copy-text={item.unlock_password} data-copy-label={t.content.passwordCopied} aria-label={t.content.copyPassword} title={t.content.copyPassword}>
                  <LucideIcon node={KeyRound} size={16} />
                </button>
              )}
            </div>

            <div class="detail-panel">
              <div class="detail-panel__head">
                <span><LucideIcon node={Package} size={15} /> {t.content.details}</span>
              </div>
              <dl class="detail-list">
                <div>
                  <dt>{t.content.type}</dt>
                  <dd>{categoryName()}</dd>
                </div>
                <div>
                  <dt>{t.content.author}</dt>
                  <dd class="detail-author">
                    {item.author.avatar_image_id && <img src={publicMediaURL(publicAPIBaseURL, item.author.avatar_image_id)} alt="" width="24" height="24" loading="lazy" decoding="async" />}
                    <a href={localizedPath(locale, `/users/${item.author.username}`)}>{item.author.display_name || item.author.username}</a>
                  </dd>
                </div>
                <div>
                  <dt>{t.content.published}</dt>
                  <dd>{publishedLabel}</dd>
                </div>
              </dl>
            </div>

            <div class="detail-panel">
              <div class="detail-panel__head">
                <span><LucideIcon node={ShieldCheck} size={15} /> {t.content.package}</span>
              </div>
              <dl class="detail-list">
                <div>
                  <dt>{t.content.file}</dt>
                  <dd>{item.file?.original_filename ?? `${item.slug}.bee`}</dd>
                </div>
                <div>
                  <dt>{t.content.size}</dt>
                  <dd>{formatBytes(item.file?.file_size)}</dd>
                </div>
                <div>
                  <dt>SHA-256</dt>
                  <dd class="detail-hash">
                    <code>{shortHash(item.file?.file_hash_sha256)}</code>
                    {item.file?.file_hash_sha256 && (
                      <button type="button" data-copy-text={item.file.file_hash_sha256} data-copy-label={t.content.shaCopied} aria-label={t.content.copySha}>
                        <LucideIcon node={Copy} size={13} />
                      </button>
                    )}
                  </dd>
                </div>
              </dl>
            </div>
          </aside>
        </section>

        <section class="detail-discussion" aria-label={t.content.discussionLabel}>
          <SocialPanel contentId={item.id} initialLikes={item.likes_count} initialLiked={item.liked_by_me} loginHref={loginHref} locale={locale} client:load />
        </section>
      </>
    )}
  </div>
</BaseLayout>
