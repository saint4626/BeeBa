---
import CatalogView from "../../../components/catalog/CatalogView.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LucideIcon from "../../../components/ui/LucideIcon.astro";
import { Boxes, Calendar, Download, Heart, PackageCheck } from "lucide";
import { getPublicAPIBaseURL } from "../../../lib/api/client";
import { getPublicProfile, listCategories, listPublicContent, listTags } from "../../../lib/api/content";
import { publicMediaURL } from "../../../lib/api/media-url";
import { PAGE_LIMITS } from "../../../lib/config/runtime";
import { localizedPath, ui } from "../../../lib/i18n";
import { buildLocaleAlternates } from "../../../lib/seo/content-url";
import { breadcrumbJsonLd, profileJsonLd } from "../../../lib/seo/structured-data";
import type { CatalogTag, Category, CursorPagination, PublicContentItem, PublicProfile } from "../../../lib/api/types";

export const prerender = false;

const { username } = Astro.params;
const locale = "ru";
const t = ui[locale];
const publicAPIBaseURL = getPublicAPIBaseURL();
const site = Astro.site ?? new URL("http://localhost:4321");

if (!username) {
  return Astro.redirect(localizedPath(locale, "/catalog"), 302);
}

let profile: PublicProfile | null = null;
let categories: Category[] = [
  { slug: "worlds", name: "Worlds" },
  { slug: "avatars", name: "Avatars" },
  { slug: "props", name: "Props" },
  { slug: "prefabs", name: "Prefabs" },
];
let tags: CatalogTag[] = [];
let items: PublicContentItem[] = [];
let pagination: CursorPagination | undefined;
let error: string | undefined;

const searchParams = Astro.url.searchParams;
const sort = searchParams.get("sort") ?? "newest";
const cursor = searchParams.get("cursor")?.trim() ?? "";
const includeNSFW = searchParams.get("include_nsfw") === "true";
const requestedCategory = searchParams.get("category")?.trim() ?? "";
const activeCategory = ["worlds", "avatars", "props", "prefabs"].includes(requestedCategory)
  ? requestedCategory as Category["slug"]
  : undefined;

try {
  profile = await getPublicProfile(username);
  const [categoryData, tagData, contentData] = await Promise.all([
    listCategories(),
    listTags(),
    listPublicContent({
      author: profile.username,
      category: activeCategory,
      sort: sort === "likes" || sort === "downloads" ? sort : "newest",
      include_nsfw: includeNSFW,
      cursor,
      limit: PAGE_LIMITS.profileAssets,
    }),
  ]);
  categories = categoryData;
  tags = tagData;
  items = contentData.data;
  pagination = contentData.pagination;
} catch (caught) {
  const message = caught instanceof Error ? caught.message : t.publicProfile.failedToLoad;
  if (message.toLowerCase().includes("not found")) {
    return Astro.redirect(localizedPath(locale, "/404"), 302);
  }
  error = message;
}

const displayName = profile?.display_name || profile?.username || username;
const hasPublicDisplayName = Boolean(profile?.display_name?.trim());
const showPublicHandle = Boolean(
  hasPublicDisplayName &&
  profile?.username &&
  profile.display_name?.trim().toLowerCase() !== profile.username.toLowerCase(),
);
const pageTitle = `${displayName} - ${t.publicProfile.titleSuffix}`;
const description = profile
  ? `${displayName} ${t.publicProfile.descriptionPrefix} ${profile.published_count} ${t.publicProfile.descriptionSuffix}`
  : t.publicProfile.fallbackDescription;
const avatarURL = publicMediaURL(publicAPIBaseURL, profile?.avatar_image_id);
const canonicalPath = `/ru/users/${username}`;
const alternatePaths = buildLocaleAlternates(`/users/${username}`, canonicalPath);
const socialImage = avatarURL ? {
  url: avatarURL,
  width: 512,
  height: 512,
  alt: `${displayName} BeeBa profile avatar`,
} : undefined;
const jsonLd = profile ? [
  breadcrumbJsonLd(site, [
    { name: t.nav.home, path: "/ru" },
    { name: displayName, path: canonicalPath },
  ]),
  profileJsonLd(site, profile, canonicalPath, avatarURL),
] : [];
const joinedAt = profile ? new Intl.DateTimeFormat(locale, { month: "short", year: "numeric" }).format(new Date(profile.created_at)) : "";
const initials = (displayName || username).slice(0, 2).toUpperCase();
---

<BaseLayout
  title={pageTitle}
  description={description}
  canonicalPath={canonicalPath}
  alternatePaths={alternatePaths}
  socialImage={socialImage}
  jsonLd={jsonLd}
>
  {error ? (
    <div class="page-container">
      <div class="empty-state">
        <span class="empty-state__badge">{t.publicProfile.apiUnavailable}</span>
        <div>
          <h1>{t.publicProfile.failedToLoad}</h1>
          <p>{error}</p>
        </div>
      </div>
    </div>
  ) : profile && (
    <>
      <div class="profile-public-shell">
        <section class="public-profile-hero" aria-labelledby="profile-title">
          <div class="public-profile-hero__identity">
            <div class="public-profile-hero__avatar" aria-hidden="true">
              {avatarURL ? <img src={avatarURL} alt="" /> : <span>{initials}</span>}
            </div>
            <div class="public-profile-hero__copy">
              <p class="eyebrow">{t.publicProfile.creatorProfile}</p>
              <h1 id="profile-title">{displayName}</h1>
              {showPublicHandle && <p>@{profile.username}</p>}
            </div>
          </div>

          <dl class="public-profile-stats" aria-label={`${displayName} ${t.publicProfile.statsLabelSuffix}`}>
            <div>
              <dt><LucideIcon node={PackageCheck} size={15} /> {t.publicProfile.published}</dt>
              <dd>{profile.published_count.toLocaleString()}</dd>
            </div>
            <div>
              <dt><LucideIcon node={Heart} size={15} /> {t.publicProfile.likes}</dt>
              <dd>{profile.likes_count.toLocaleString()}</dd>
            </div>
            <div>
              <dt><LucideIcon node={Download} size={15} /> {t.publicProfile.downloads}</dt>
              <dd>{profile.downloads_count.toLocaleString()}</dd>
            </div>
            <div>
              <dt><LucideIcon node={Calendar} size={15} /> {t.publicProfile.joined}</dt>
              <dd>{joinedAt}</dd>
            </div>
          </dl>
        </section>

        <section class="public-profile-assets" aria-labelledby="profile-assets-title">
          <div class="public-profile-assets__head">
            <div>
              <p class="eyebrow"><LucideIcon node={Boxes} size={14} /> {t.publicProfile.publicLibrary}</p>
              <h2 id="profile-assets-title">{t.publicProfile.publishedAssets}</h2>
            </div>
            <p>{t.publicProfile.publicAssetsCopy}</p>
          </div>

          <CatalogView
            items={items}
            pagination={pagination}
            categories={categories}
            tags={tags}
            query=""
            activeTags={[]}
            sort={sort === "likes" || sort === "downloads" ? sort : "newest"}
            includeNSFW={includeNSFW}
            activeCategory={activeCategory}
            error={error}
            baseCatalogPath={localizedPath(locale, `/users/${profile.username}`)}
            categoryParamMode="query"
            author={profile.username}
            locale={locale}
          />
        </section>
      </div>
    </>
  )}
</BaseLayout>
