---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localizedPath, ui } from "../../lib/i18n";

Astro.response.status = 404;
const locale = "ru";
const t = ui[locale];
---

<BaseLayout
  title={t.notFound.title}
  description={t.notFound.description}
  canonicalPath="/ru/404"
  robots="noindex, nofollow"
>
  <main class="not-found-page" aria-labelledby="not-found-title">
    <div class="not-found-page__content">
      <span class="empty-state__badge">{t.notFound.badge}</span>
      <h1 id="not-found-title">{t.notFound.heading}</h1>
      <p>{t.notFound.copy}</p>
      <div class="not-found-page__actions">
        <a class="button button--primary" href={localizedPath(locale, "/")}>{t.nav.home}</a>
        <a class="button button--secondary" href={localizedPath(locale, "/catalog")}>{t.nav.catalog}</a>
      </div>
    </div>
  </main>
</BaseLayout>
