---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmailVerificationApp from "../components/auth/EmailVerificationApp.vue";
import { ui } from "../lib/i18n";

const locale = "en";
const t = ui[locale];
---

<BaseLayout
  title={t.verifyEmail.title}
  description={t.verifyEmail.description}
  robots="noindex, nofollow"
>
  <section class="page-shell page-shell--narrow">
    <EmailVerificationApp client:load locale={locale} profileHref="/profile" />
  </section>
</BaseLayout>
