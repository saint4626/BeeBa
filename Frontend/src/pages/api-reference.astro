---
import { Buffer } from "node:buffer";
import { ui } from "../lib/i18n";
import { globalJsonLd, serializeJsonLd } from "../lib/seo/structured-data";

const openApiUrl = "/openapi.yaml";
const locale = "en";
const t = ui[locale].apiReference;
const title = t.title;
const description = t.description;
const site = Astro.site ?? new URL("http://localhost:4321");
const canonical = new URL("/api-reference", site);
const ruCanonical = new URL("/ru/api-reference", site);
const socialImage = new URL("/OG-Image.png", site);
const socialImageAlt = "BeeBa Basis VR content catalog";
const jsonLdPayloads = globalJsonLd(site).map(serializeJsonLd);
for (const payload of jsonLdPayloads) {
  Astro.csp?.insertScriptHash(await cspHash(payload));
}

async function cspHash(value: string) {
  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value));
  return `sha256-${Buffer.from(digest).toString("base64")}` as const;
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="en" href={canonical.href} />
    <link rel="alternate" hreflang="ru" href={ruCanonical.href} />
    <link rel="alternate" hreflang="x-default" href={canonical.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:secure_url" content={socialImage.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {jsonLdPayloads.map((payload) => <script type="application/ld+json" set:html={payload} />)}
    <style>
      :root {
        color-scheme: dark;
      }

      html,
      body {
        width: 100%;
        min-width: 320px;
        min-height: 100%;
        margin: 0;
        background: #002b36;
      }

      body {
        overflow: auto;
      }

      #scalar-api-reference {
        min-height: 100vh;
      }
    </style>
  </head>
  <body>
    <main id="scalar-api-reference" data-openapi-url={openApiUrl}></main>

    <script>
      import { createApiReference } from "@scalar/api-reference";
      import "@scalar/api-reference/style.css";

      const container = document.querySelector("#scalar-api-reference");
      const openApiUrl = container?.getAttribute("data-openapi-url") ?? "/openapi.yaml";

      createApiReference("#scalar-api-reference", {
        url: openApiUrl,
          pageTitle: "BeeBa API Reference",
        theme: "solarized",
        darkMode: true,
        forceDarkModeState: "dark",
        hideDarkModeToggle: true,
        layout: "modern",
        showDeveloperTools: "never",
        agent: {
          disabled: true,
        },
        defaultHttpClient: {
          targetKey: "shell",
          clientKey: "curl",
        },
        metaData: {
          title: "BeeBa API Reference",
          description: "Interactive OpenAPI reference for the BeeBa API.",
        },
      });
    </script>
  </body>
</html>
