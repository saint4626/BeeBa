FROM node:22.12-alpine AS deps

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22.12-alpine AS build

WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG PUBLIC_API_BASE_URL=/api/v1
ARG PUBLIC_STATUS_URL=https://status.beeba.org
ARG PUBLIC_SITE_URL=https://beeba.org
ARG PUBLIC_MAX_IMAGE_UPLOAD_BYTES=8388608
ARG PUBLIC_CATALOG_PAGE_LIMIT=24
ARG PUBLIC_HOME_SOURCE_LIMIT=10
ARG PUBLIC_HOME_NEWEST_LIMIT=8
ARG PUBLIC_HOME_FEATURED_LIMIT=12
ARG PUBLIC_PROFILE_ASSETS_LIMIT=12
ARG PUBLIC_OWNER_CONTENT_LIMIT=12
ARG PUBLIC_SOCIAL_COMMENT_LIMIT=24
ARG PUBLIC_ADMIN_PAGE_LIMIT=50
ARG PUBLIC_ADMIN_POLL_INTERVAL_MS=15000

ENV PUBLIC_API_BASE_URL=$PUBLIC_API_BASE_URL
ENV PUBLIC_STATUS_URL=$PUBLIC_STATUS_URL
ENV PUBLIC_SITE_URL=$PUBLIC_SITE_URL
ENV PUBLIC_MAX_IMAGE_UPLOAD_BYTES=$PUBLIC_MAX_IMAGE_UPLOAD_BYTES
ENV PUBLIC_CATALOG_PAGE_LIMIT=$PUBLIC_CATALOG_PAGE_LIMIT
ENV PUBLIC_HOME_SOURCE_LIMIT=$PUBLIC_HOME_SOURCE_LIMIT
ENV PUBLIC_HOME_NEWEST_LIMIT=$PUBLIC_HOME_NEWEST_LIMIT
ENV PUBLIC_HOME_FEATURED_LIMIT=$PUBLIC_HOME_FEATURED_LIMIT
ENV PUBLIC_PROFILE_ASSETS_LIMIT=$PUBLIC_PROFILE_ASSETS_LIMIT
ENV PUBLIC_OWNER_CONTENT_LIMIT=$PUBLIC_OWNER_CONTENT_LIMIT
ENV PUBLIC_SOCIAL_COMMENT_LIMIT=$PUBLIC_SOCIAL_COMMENT_LIMIT
ENV PUBLIC_ADMIN_PAGE_LIMIT=$PUBLIC_ADMIN_PAGE_LIMIT
ENV PUBLIC_ADMIN_POLL_INTERVAL_MS=$PUBLIC_ADMIN_POLL_INTERVAL_MS

RUN npm run build

FROM node:22.12-alpine

WORKDIR /app
ENV HOST=0.0.0.0
ENV PORT=4321

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/dist ./dist

EXPOSE 4321
CMD ["npm", "run", "start"]
