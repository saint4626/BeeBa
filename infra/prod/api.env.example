BEEBA_ENV=production
BEEBA_PUBLIC_BASE_URL=https://beeba.org
BEEBA_CORS_ALLOWED_ORIGINS=https://beeba.org,https://www.beeba.org,https://api.beeba.org

POSTGRES_USER=beeba
POSTGRES_PASSWORD=replace-with-strong-random-password
POSTGRES_DB=beeba

MEILI_MASTER_KEY=replace-with-strong-random-key

MINIO_ROOT_USER=replace-with-storage-access-key
MINIO_ROOT_PASSWORD=replace-with-storage-secret-key
BEEBA_MINIO_ENDPOINT=s3.beeba.org
BEEBA_MINIO_USE_SSL=true

BEEBA_SECRET_BOX_KEY=replace-with-base64-encoded-32-byte-key
BEEBA_HTTP_READ_TIMEOUT=20m
BEEBA_HTTP_WRITE_TIMEOUT=20m
BEEBA_UPLOAD_STORAGE_TIMEOUT=20m
BEEBA_EMAIL_DELIVERY_ENABLED=true
BEEBA_EMAIL_FROM="BeeBa <hello@beeba.org>"
BEEBA_EMAIL_REPLY_TO=
BEEBA_EMAIL_DAILY_LIMIT=90
BEEBA_RESEND_API_KEY=replace-with-resend-api-key
BEEBA_RESEND_API_BASE_URL=https://api.resend.com
BEEBA_TURNSTILE_REQUIRED=true
BEEBA_TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret-key
BEEBA_TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
BEEBA_SERVER_CHECK_SCHEDULER_INTERVAL=1m
BEEBA_SERVER_CHECK_PENDING_INTERVAL=1m
BEEBA_SERVER_CHECK_ONLINE_INTERVAL=5m
BEEBA_SERVER_CHECK_OFFLINE_INTERVAL=2m
BEEBA_SERVER_CHECK_BATCH_SIZE=12
BEEBA_RATE_LIMIT_AUTH_ACCOUNT_CHANGE_LIMIT=5
BEEBA_RATE_LIMIT_AUTH_ACCOUNT_CHANGE_WINDOW=1h
BEEBA_RATE_LIMIT_SERVER_WRITE_LIMIT=20
BEEBA_RATE_LIMIT_SERVER_WRITE_WINDOW=1h
BEEBA_RATE_LIMIT_SERVER_VERIFY_LIMIT=20
BEEBA_RATE_LIMIT_SERVER_VERIFY_WINDOW=1h

KENER_SECRET_KEY=replace-with-strong-random-key
KENER_ORIGIN=https://status.beeba.org
KENER_STORAGE_HEALTH_URL=https://s3.beeba.org/minio/health/ready
KENER_SOCIAL_HEALTH_URL=https://social.beeba.org/readyz

PUBLIC_API_BASE_URL=/api/v1
PUBLIC_STATUS_URL=https://status.beeba.org
PUBLIC_SITE_URL=https://beeba.org
PUBLIC_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key
